# FinSure Frontend Environment Configuration
# Copy to .env.local for local development overrides

# Base URL for FinSure backend API endpoints
# Defaults to '/api/v1' which proxies to backend:8000 via Vite in dev
VITE_API_BASE_URL=/api/v1

# Enable/Disable 3D WebGL Canvas features (defaults to true)
VITE_ENABLE_3D=true
