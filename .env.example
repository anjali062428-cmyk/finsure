# FinSure Environment Configuration Example
# Copy to .env and configure for your environment

# Environment & Server
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
POSTGRES_USER=finsure_user
POSTGRES_PASSWORD=finsure_secure_password
POSTGRES_DB=finsure
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://finsure_user:finsure_secure_password@localhost:5432/finsure

# Cache & Feature Engine (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
# Generate secure keys in production: openssl rand -hex 32
JWT_SECRET=finsure_dev_secret_key_minimum_32_characters_long_for_security
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Notification Providers (console mock by default in dev)
EMAIL_PROVIDER=console
SMS_PROVIDER=console
# In production:
# EMAIL_PROVIDER=smtp (or sendgrid, ses)
# SMS_PROVIDER=msg91 (or twilio, firebase) - Note: MSG91 in India requires DLT registration

# Fraud Engine & Adaptive Decision Thresholds (0 - 100 Scale)
# Score < APPROVE: Approve instantly
# APPROVE <= Score < BLOCK: Step-up authentication (OTP challenge)
# Score >= BLOCK: Block payment, create alert & report
THRESHOLD_APPROVE=40
THRESHOLD_BLOCK=90

# FinSure Investigator (Assistive read-only investigation agent)
# Options: template (default, deterministic, zero-hallucination), ollama, hosted
INVESTIGATOR_PROVIDER=template
INVESTIGATOR_MODEL=none

# ML & Monitoring
MLFLOW_TRACKING_URI=http://localhost:5000
PROMETHEUS_METRICS_ENABLED=true
